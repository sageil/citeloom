{
  "name": "citeloom",
  "version": "0.1.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Private documents, woven into cited answers.",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": ">=11.0.0 <12.0.0"
    }
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "ask": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts ask",
    "build": "pnpm build:server",
    "build:server": "node --import tsx scripts/build-server.ts",
    "backup": "./infra/scripts/backup.sh",
    "check": "pnpm validate:corpus && pnpm validate:evaluations && pnpm lint && pnpm typecheck && pnpm test:all && pnpm build",
    "corpus:download": "node --import tsx tools/evaluation/corpus/download-cli.ts",
    "corpus:reconcile": "node --env-file-if-exists=.env.development --import tsx tools/evaluation/corpus/reconcile-cli.ts",
    "dev": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts",
    "dev:web": "node --env-file-if-exists=.env.development --import tsx --watch src/web-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.development --import tsx src/database/migrate.ts",
    "db:migrate:production": "node --env-file-if-exists=.env dist/database/migrate.js",
    "db:reset:development": "node --env-file-if-exists=.env.development --import tsx src/database/reset-development.ts",
    "db:setup": "pnpm db:migrate",
    "documents": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts documents",
    "doctor:docker": "./infra/compose.sh --profile web run --rm --no-deps web node dist/cli/index.js doctor",
    "doctor:source": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts doctor",
    "docling:benchmark": "node --env-file-if-exists=.env.development --import tsx scripts/docling-benchmark/cli.ts",
    "evaluate": "node --env-file-if-exists=.env.development --import tsx tools/evaluation/cli.ts",
    "evaluate:generate": "node --env-file-if-exists=.env.development --import tsx tools/evaluation/cli.ts --generate",
    "ingest": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts ingest",
    "jobs": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts jobs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "restore": "./infra/scripts/restore.sh",
    "services:down": "./infra/compose.sh down",
    "services:logs": "./infra/compose.sh logs -f",
    "services:test:stop": "./infra/compose.sh --profile test stop postgres-test",
    "services:test:up": "./infra/compose.sh --profile test up -d --wait postgres-test",
    "services:up": "./infra/compose.sh up -d",
    "status": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts status",
    "probe:answer-draft:lm-studio": "node --import tsx scripts/probes/lm-studio-answer-draft.ts",
    "probe:answer-draft:ollama": "node --import tsx scripts/probes/ollama-answer-draft.ts",
    "test": "vitest run --exclude test/database.integration.test.ts --exclude test/auth-database.integration.test.ts --exclude test/hhem-live.integration.test.ts --exclude 'test/evaluation*.test.ts' --exclude 'test/corpus*.test.ts' --exclude test/cli.test.ts --exclude test/command-runner.test.ts",
    "test:all": "vitest run --exclude test/database.integration.test.ts --exclude test/auth-database.integration.test.ts --exclude test/hhem-live.integration.test.ts",
    "test:backup-restore": "./infra/scripts/test-backup-restore.sh",
    "test:integration": "vitest run --no-file-parallelism test/database.integration.test.ts test/auth-database.integration.test.ts",
    "test:live": "HHEM_LIVE_TEST=true vitest run test/hhem-live.integration.test.ts",
    "test:vision:qwen": "QWEN_VISION_LIVE_TEST=true vitest run --no-file-parallelism test/qwen-vision-live.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:evaluations": "node --import tsx scripts/validate-evaluations.ts",
    "validate:evaluations:live": "node --env-file-if-exists=.env.development --import tsx scripts/validate-evaluation-index.ts",
    "validate:corpus": "node --import tsx scripts/validate-corpus.ts",
    "validate:benchmark": "pnpm validate:corpus && pnpm validate:evaluations && pnpm validate:evaluations:live",
    "web": "pnpm build && node --env-file-if-exists=.env dist/web-server.js",
    "worker": "node --env-file-if-exists=.env.development --import tsx src/cli/index.ts worker",
    "worker:production": "node --env-file-if-exists=.env dist/cli/index.js worker"
  },
  "dependencies": {
    "@ai-sdk/cohere": "4.0.12",
    "@ai-sdk/openai": "4.0.20",
    "@ai-sdk/openai-compatible": "3.0.14",
    "@ai-sdk/provider": "4.0.3",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "ai": "7.0.37",
    "ai-sdk-ollama": "4.0.0",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "franc-min": "6.2.0",
    "js-tiktoken": "1.0.21",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.22.0",
    "undici": "8.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
