# For development, copy this file to .env.development.
# For production or Docker Compose, copy it to .env.
# CiteLoom does not load this template directly.

# Application release identifier stored with operational error events.
CITELOOM_RELEASE=0.3.6
# Exact semantic-version tag used by compose.dockerhub.yml.
CITELOOM_IMAGE_TAG=0.3.6
# Database connectivity.
DATABASE_URL=postgresql://citeloom:citeloom@127.0.0.1:5432/citeloom
# Persistent PostgreSQL cluster storage for Compose.
CITELOOM_POSTGRES_DATA_DIRECTORY=./data/citeloomdb
# Host directory that Compose uses to store unmodified source files.
CITELOOM_SOURCE_CONTENT_HOST_DIRECTORY=./documents/blobs
# Source-file path saved to PostgreSQL by migrations that run outside Compose.
# The host-run development benchmark also uses this path to read source bytes.
# The supplied Compose migration service uses /app/documents/blobs.
CITELOOM_SOURCE_CONTENT_DIRECTORY=documents/blobs

# Optional SeaweedFS S3 storage.
# Start it with: docker compose -f compose.yml -f compose.seaweedfs.yml up -d
# CITELOOM_S3_ACCESS_KEY_ID=
# CITELOOM_S3_SECRET_ACCESS_KEY=
CITELOOM_SOURCE_CONTENT_S3_BUCKET=citeloom
CITELOOM_SOURCE_CONTENT_S3_PREFIX=sources
CITELOOM_SOURCE_CONTENT_S3_REGION=us-east-1
CITELOOM_SEAWEEDFS_DATA_DIRECTORY=./data/seaweedfs

# Required every time database migrations run.
# A new database uses these values for its first administrator.
# An existing database keeps its stored accounts unchanged.
# CITELOOM_ADMIN_USERNAME=
# CITELOOM_ADMIN_PASSWORD=

# Configure application, Docling, HHEM, web, and database-pool settings in CiteLoom Settings.
# This host port remains deployment configuration because it controls Compose publication.
HHEM_PORT=8088

# Host-run web process configuration.
# Docker web replicas always listen on internal port 3000 and are exposed through the HTTPS proxy.
CITELOOM_WEB_HOST=127.0.0.1
CITELOOM_WEB_PORT=3000
CITELOOM_UPLOAD_DIRECTORY=documents/uploads

# Optional Logto OSS deployment used by compose.logto.yml.
# Every uncommented value is required when that Compose file is used.
# LOGTO_COMPOSE_PROJECT_NAME=
# LOGTO_IMAGE=
# LOGTO_POSTGRES_IMAGE=
# LOGTO_POSTGRES_USER=
# LOGTO_POSTGRES_PASSWORD=
# LOGTO_POSTGRES_DATABASE=
# LOGTO_DATABASE_URL=
# LOGTO_ENDPOINT=
# LOGTO_ADMIN_ENDPOINT=
# LOGTO_BIND_ADDRESS=
# LOGTO_PUBLIC_PORT=
# LOGTO_ADMIN_PORT=
# LOGTO_PUBLIC_CONTAINER_PORT=
# LOGTO_ADMIN_CONTAINER_PORT=
# LOGTO_TRUST_PROXY_HEADER=
# LOGTO_POSTGRES_DATA_DIRECTORY=
# LOGTO_POSTGRES_DATA_TARGET=
# LOGTO_RESTART_POLICY=
